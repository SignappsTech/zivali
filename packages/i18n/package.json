{
	"name": "@zivali/i18n",
	"version": "0.0.0",
	"private": true,
	"description": "SL and EN ICU message catalogues and Intl format helpers for web, mobile and the API worker (contract C16, ADR-008)",
	"type": "module",
	"exports": {
		"./dist/sl.json": "./dist/sl.json",
		"./dist/en.json": "./dist/en.json",
		"./format": "./src/format.ts"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "node build.mjs",
		"check": "node check.mjs",
		"lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings=0 .",
		"typecheck": "tsc --noEmit",
		"test": "node check.mjs && node --test"
	},
	"devDependencies": {
		"use-intl": "^4.14.9"
	},
	"engines": {
		"node": ">=22"
	}
}
