		"react": "^19.0.0",
		"react-redux": "^9.0.0"
	},
	"devDependencies": {
		"@supabase/supabase-js": "^2.117.3",
		"@rtk-query/codegen-openapi": "^2.2.0",
		"@types/node": "^22.19.0",
		"@types/react": "^19.3.0",
		"react": "~19.3.0",
		"react-redux": "^9.3.0"
	},
	"engines": {
		"node": ">=22"
	}
}
