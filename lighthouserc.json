{
	"ci": {
		"collect": {
			"url": [
				"http://localhost:8080/",
				"http://localhost:8080/en",
				"http://localhost:8080/kako-deluje",
				"http://localhost:8080/varnost",
				"http://localhost:8080/pogosta-vprasanja",
				"http://localhost:8080/za-zavetisca",
				"http://localhost:8080/o-nas",
				"http://localhost:8080/zavetisca",
				"http://localhost:8080/zavetisca/zavetisce-ljubljana",
				"http://localhost:8080/zemljevid",
				"http://localhost:8080/prijava/izgubljena-zival"
			],
			"numberOfRuns": 2,
			"settings": { "formFactor": "mobile" }
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": "^(?!.*/zemljevid$).*$",
					"assertions": {
						"categories:performance": ["error", { "minScore": 0.9 }],
						"categories:accessibility": ["error", { "minScore": 0.95 }],
						"categories:seo": ["error", { "minScore": 0.95 }],
						"categories:best-practices": ["error", { "minScore": 0.9 }],
						"largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
						"cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
						"resource-summary:script:size": ["error", { "maxNumericValue": 256000 }],
						"total-byte-weight": ["warn", { "maxNumericValue": 1000000 }]
					}
				},
				{
					"matchingUrlPattern": "/zemljevid$",
					"assertions": {
						"categories:performance": ["error", { "minScore": 0.8 }],
						"categories:accessibility": ["error", { "minScore": 0.95 }],
						"categories:seo": ["error", { "minScore": 0.95 }],
						"categories:best-practices": ["error", { "minScore": 0.9 }],
						"largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
						"cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
						"resource-summary:script:size": ["error", { "maxNumericValue": 320000 }],
						"total-byte-weight": ["warn", { "maxNumericValue": 1000000 }]
					}
				}
			]
		},
		"upload": { "target": "filesystem", "outputDir": "./quality-report/lighthouse" }
	}
}
