{
	"ci": {
		"collect": {
			"url": [
				"http://localhost:8080/",
				"http://localhost:8080/en",
				"http://localhost:8080/zavetisca",
				"http://localhost:8080/zavetisca/zavetisce-ljubljana"
			],
			"numberOfRuns": 2,
			"settings": { "formFactor": "mobile" }
		},
		"assert": {
			"assertions": {
				"categories:performance": ["error", { "minScore": 0.9 }],
				"categories:accessibility": ["error", { "minScore": 0.95 }],
				"categories:seo": ["error", { "minScore": 0.95 }],
				"categories:best-practices": ["error", { "minScore": 0.9 }],
				"largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
				"cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
				"resource-summary:script:size": ["error", { "maxNumericValue": 256000 }],
				"total-byte-weight": ["warn", { "maxNumericValue": 1000000 }]
			}
		},
		"upload": { "target": "filesystem", "outputDir": "./quality-report/lighthouse" }
	}
}
