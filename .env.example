# Every environment variable the workspace reads, names only (docs/tech/frontend.md, docs/tech/backend.md).
# Never commit values. Each block says which gitignored file holds it locally.
# Local development needs none of the credentials: with empty values every adapter falls back to its mock,
# and the local Supabase URL and keys come from `pnpm exec supabase status`.

# --- apps/web/.env.local (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
# required unless APP_ENV=local (then defaults to http://localhost:4000)
NEXT_PUBLIC_API_URL=
# local | staging | production
APP_ENV=
# web, server only: origin the API presigns photo PUTs with; https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com outside local (defaults to http://127.0.0.1:9000, MinIO)
R2_UPLOAD_ORIGIN=
# web, server only: Apple Team ID and Android signing SHA-256 fingerprint(s), comma-separated, for /.well-known (Q-007); empty = that platform's entry is omitted
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
# mock | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# empty = captcha off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# true once the provider is enabled in Supabase Auth (web sign-in buttons); Apple stays off until its account exists
NEXT_PUBLIC_GOOGLE_SIGN_IN=
NEXT_PUBLIC_APPLE_SIGN_IN=
# pk_test_ only (value of the team's STRIPE_PUBLISHABLE_KEY); optional, Checkout is server-created
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# server only: GA Data API (partner stats behind a flag); the key file stays in .secrets/
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_FILE=

# --- apps/mobile/.env.local (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_URL=
# on a device use the LAN IP or a tunnel, not localhost
EXPO_PUBLIC_API_URL=
# local | staging | production
EXPO_PUBLIC_APP_ENV=
# mock | firebase
EXPO_PUBLIC_ANALYTICS_PROVIDER=
# mock | expo (default mock until FCM/APNs credentials exist, Q-007)
EXPO_PUBLIC_PUSH_PROVIDER=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# true once the Apple Developer account exists (iOS only; needs a new build)
EXPO_PUBLIC_APPLE_SIGN_IN=
# true = Turnstile through the web /captcha page before anonymous sign-in (C7); empty = off (local)
EXPO_PUBLIC_CAPTCHA=
# EAS file secrets; locally paths to the files in .secrets/
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# --- apps/api/.env.local (Express API and worker; on the VPS /opt/zivali/<env>/.env) ---
# local | staging | production
APP_ENV=
# returned by /v1/health/ready (default dev)
APP_VERSION=
# 4000
PORT=
API_URL=
APP_URL=
# comma-separated web origins for CORS
WEB_ORIGINS=
# local postgresql://postgres:postgres@127.0.0.1:54322/postgres (with ?schema=app)
DATABASE_URL=
# migrations (direct connection)
DIRECT_URL=
SUPABASE_URL=
# Supabase Admin API only
SUPABASE_SECRET_KEY=
# local HS256 fallback for JWT verification
SUPABASE_JWT_SECRET=
# random 32-byte secrets per environment
FUZZ_SECRET=
RATE_SALT=
IDEMPOTENCY_KEY=
# minio | r2 | memory | off (production and staging: a configured provider or an explicit off)
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
R2_BUCKET_MEDIA=
R2_BUCKET_BACKUPS=
MEDIA_BASE_URL=
# MinIO locally
S3_ENDPOINT=
# mock | stripe | off (test keys only; live keys are rejected)
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=
# Fiscal invoices (TASK-92): mock (default) | furs (FURS test environment only) | off. Premise and device as
# registered with FURS (deploy/README.md §10); the FURS_* paths point to PEM files outside the repo.
FISCAL_PROVIDER=
FISCAL_TAX_NUMBER=
FISCAL_PREMISE_ID=
FISCAL_DEVICE_ID=
FURS_URL=
FURS_CERT_PATH=
FURS_KEY_PATH=
FURS_KEY_PASSPHRASE=
FURS_CA_PATH=
# mock | brevo | off
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
LEADS_NOTIFY_EMAIL=
# mock | expo | off
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
# mock | turnstile | off (leads form; Auth captcha is configured in Supabase)
CAPTCHA_PROVIDER=
TURNSTILE_SECRET_KEY=
# mock | anthropic | off (M3)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_VISION_MODEL=
AI_VISION_EFFORT=
# mock | voyage | off (M3)
EMBEDDER_PROVIDER=
VOYAGE_API_KEY=
# partner-stats enrichment behind a flag; the key file stays in .secrets/
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_FILE=

# --- supabase/.env (read by env() in supabase/config.toml; a provider is enabled only with _ENABLED=true and its credentials) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=
SUPABASE_AUTH_EXTERNAL_APPLE_ENABLED=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- .env.local at the repo root (scripts/*.mjs, scripts/deploy.mjs, CI secrets) ---
SUPABASE_URL=
# source for NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
# staging = najdimo
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# the VPS IPv4 (user deploy; `user@ip` for another); the SSH private key (content or a path); the pinned host key
# (`ssh-keyscan -t ed25519 <ip>` output, checked against the server console: deploy/README.md)
HETZNER_HOST=
HETZNER_SSH_KEY=
HETZNER_KNOWN_HOSTS=
# optional: a deploy opens port 22 of the Cloud Firewall for this machine's IPv4 while it runs (deploy/README.md)
HETZNER_API_TOKEN=
HETZNER_FIREWALL_ID=
# this environment's public hostnames (staging: staging.najdimo.si, api-staging.najdimo.si; .env.production.local:
# najdimo.si, api.najdimo.si)
WEB_HOST=
API_HOST=
# certbot DNS-01 token (Cloudflare, Zone DNS Edit on najdimo.si only)
CERTBOT_CLOUDFLARE_TOKEN=
EXPO_TOKEN=
# sk_test_ only
STRIPE_SECRET_KEY=
# pk_test_ only; source for NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_PUBLISHABLE_KEY=
# GA admin checks; the key file stays in .secrets/
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_FILE=
