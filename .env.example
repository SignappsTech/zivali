# Every environment variable the workspace reads, names only (docs/tech/frontend.md, docs/tech/backend.md).
# Never commit values. Each block says which gitignored file holds it locally.
# Local development needs none of the credentials: with empty values every adapter falls back to its mock,
# and the local Supabase URL and keys come from `pnpm exec supabase status`.

# --- apps/web/.env.local (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
# local | staging | production
APP_ENV=
# mock | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# maptiler | photon | mock
NEXT_PUBLIC_GEOCODER=
NEXT_PUBLIC_MAPTILER_KEY=
# empty = captcha off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# server routes only (ad click, OG images); never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# pk_test_ only (value of the team's STRIPE_PUBLISHABLE_KEY); optional, Checkout is server-created
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# server only: GA Data API (partner stats behind a flag); the key file stays in .secrets/
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_FILE=

# --- apps/mobile/.env.local (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_URL=
# local | staging | production
EXPO_PUBLIC_APP_ENV=
# mock | firebase
EXPO_PUBLIC_ANALYTICS_PROVIDER=
# maptiler | photon | mock
EXPO_PUBLIC_GEOCODER=
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EAS file secrets; locally paths to the files in .secrets/
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# --- supabase/functions/.env.local (Edge Functions; SUPABASE_URL and keys are injected by the CLI) ---
APP_URL=
# local | staging | production
APP_ENV=
# optional; returned by the health function as version (default dev)
APP_VERSION=
# mock | stripe (test keys only; live keys are rejected)
PAYMENTS_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=
# mock | brevo
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
LEADS_NOTIFY_EMAIL=
# mock | expo
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
# mock | turnstile
CAPTCHA_PROVIDER=
TURNSTILE_SECRET_KEY=
# mock | anthropic (M3)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_VISION_MODEL=
AI_VISION_EFFORT=
# mock | voyage (M3)
EMBEDDER_PROVIDER=
VOYAGE_API_KEY=

# --- supabase/.env (read by env() in supabase/config.toml; a provider is enabled only when set) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- .env.local at the repo root (scripts/*.mjs, deploy, CI) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# legacy keys, still accepted; prefer the publishable and secret keys above
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
# staging = najdimo
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
EXPO_TOKEN=
# sk_test_ only
STRIPE_SECRET_KEY=
# pk_test_ only; source for NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
STRIPE_PUBLISHABLE_KEY=
# public, domain-restricted; source for NEXT_PUBLIC_MAPTILER_KEY and EXPO_PUBLIC_MAPTILER_KEY
MAPTILER_API_KEY=
# GA admin checks and partner-stats enrichment; the key file stays in .secrets/
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_FILE=

# Database Vault secrets (not environment variables): worker_url, worker_key, fuzz_secret, rate_salt.
# Set by a migration locally and by scripts/deploy.mjs in the cloud.
