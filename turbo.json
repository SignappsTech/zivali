{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
	"globalEnv": ["APP_ENV"],
	"globalPassThroughEnv": ["DATABASE_URL", "DIRECT_URL", "TEST_DATABASE_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"dev:worker": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"web#typecheck": {
			"dependsOn": ["^build", "web#build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"passThroughEnv": ["SUPABASE_*", "DATABASE_URL", "DIRECT_URL", "TEST_DATABASE_URL", "REALTIME_URL"],
			"outputs": ["coverage/**"]
		}
	}
}
