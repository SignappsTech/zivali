        "body-lg": { "family": "sans", "weight": 400, "mobile": "lg", "desktop": "lg", "tracking": "0" },
        "body": { "family": "sans", "weight": 400, "mobile": "base", "desktop": "base", "tracking": "0" },
        "label-strong": { "family": "sans", "weight": 700, "mobile": "base", "desktop": "base", "tracking": "0" },
        "label": { "family": "sans", "weight": 600, "mobile": "base", "desktop": "base", "tracking": "0" },
        "caption": { "family": "sans", "weight": 400, "mobile": "sm", "desktop": "sm", "tracking": "0" },
        "badge": { "family": "sans", "weight": 600, "mobile": "xs", "desktop": "xs", "tracking": "0.01em" }
      },
      "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
      "numeric": "Use tabular-nums for chip numbers, distances, times and counts."
    },
    "space": {
      "unit": 4,
      "steps": {
        "0": 0,
        "1": 4,
        "2": 8,
        "3": 12,
        "4": 16,
        "5": 20,
        "6": 24,
        "8": 32,
        "10": 40,
        "12": 48,
        "14": 56,
        "16": 64,
        "20": 80,
        "24": 96,
        "0.5": 2,
        "1.5": 6
      },
      "layout": {
        "gutter-mobile": 20,
        "gutter-desktop": 48,
        "section-gap-mobile": 48,
        "section-gap-desktop": 96,
        "content-max": 1120,
        "container-max": 1280,
        "reading-max": 640,
        "stack-row": 20,
        "stack-section": 40
      }
    },
    "radius": {
      "formula": { "sm": "radius - 4px", "md": "radius - 2px", "lg": "radius", "xl": "radius + 4px", "2xl": "radius + 8px", "full": "9999px" }
    },
    "size": {
      "touch-min": 44,
      "touch-comfort": 48,
      "touch-primary": 56,
      "icon-sm": 16,
      "icon-md": 20,
      "icon-lg": 24,
