        "h2": { "family": "display", "weight": 700, "mobile": "2xl", "desktop": "3xl", "tracking": "-0.015em" },
        "h3": { "family": "display", "weight": 600, "mobile": "xl", "desktop": "2xl", "tracking": "-0.01em" },
