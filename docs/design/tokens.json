    "motion": {
      "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 360 },
      "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0.16, 1, 0.3, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
      "reducedMotion": "Replace translate and scale with opacity cross-fade at 80ms. Never autoplay loops."
    },
    "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 },
    "zIndex": { "base": 0, "sticky": 20, "bottomnav": 30, "sheet": 40, "overlay": 50, "dialog": 60, "toast": 70 },
