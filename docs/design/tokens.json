{
  "$meta": {
    "name": "najdimo-tokens",
    "version": "0.5.2",
    "status": "direction-chosen (A, Lagoon)",
    "description": "Single source of truth for design tokens. Web (shadcn/ui, Tailwind) and mobile (React Native Reusables, NativeWind) both consume this file through packages/tokens. Semantic tokens use the shadcn CSS-variable vocabulary plus app tokens (status, map, premium).",
    "valueFormats": {
      "ref": "\"scale.step\" points at primitives.color.<scale>.<step>, for example \"lagoon.700\"",
      "refWithAlpha": "{ \"ref\": \"coral.500\", \"alpha\": 0.16 } for translucent fills",
      "literal": "\"#RRGGBB\" is allowed for map-only colours that are not part of a scale",
      "css": "Generated CSS emits colours as HSL triplets (\"H S% L%\") so Tailwind 3.4 and NativeWind 4 can use hsl(var(--token) / <alpha-value>)"
    },
    "naming": "Token keys equal the CSS variable name without the leading dashes. Example: key \"status-lost-subtle-foreground\" becomes --status-lost-subtle-foreground.",
    "contrast": "AA is the floor (4.5:1 text, 3:1 UI and graphics). Body text and primary actions target AAA (7:1) for outdoor sunlight use. build-tokens.mjs fails when a declared pair drops below its minimum.",
    "style": "Clean and calm: flat surfaces separated by tone and space, no card borders, no shadows except floating overlays, one accent (teal) used sparingly, status shown as icon plus coloured word."
  },
