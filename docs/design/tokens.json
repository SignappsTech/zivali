  "elevation": {
    "light": { "shadow-sm": "none", "shadow-md": "0 2px 10px 0 rgb(16 38 43 / 0.08)", "shadow-lg": "0 -10px 40px -12px rgb(16 38 43 / 0.16)", "shadow-pop": "0 8px 24px -6px rgb(16 38 43 / 0.18)" },
    "dark": { "shadow-sm": "none", "shadow-md": "0 2px 10px 0 rgb(0 0 0 / 0.4)", "shadow-lg": "0 -10px 40px -12px rgb(0 0 0 / 0.6)", "shadow-pop": "0 8px 24px -6px rgb(0 0 0 / 0.55)" },
    "usage": "sm: unused (flat). md: controls floating over the map. lg: bottom sheets, dialogs, popovers. Cards never carry a shadow.",
    "reactNative": {
      "sm": { "elevation": 0, "shadowOpacity": 0, "shadowRadius": 0, "shadowOffsetY": 0 },
      "md": { "elevation": 2, "shadowOpacity": 0.08, "shadowRadius": 10, "shadowOffsetY": 2 },
      "lg": { "elevation": 8, "shadowOpacity": 0.16, "shadowRadius": 32, "shadowOffsetY": -8 },
      "pop": { "elevation": 6, "shadowOpacity": 0.18, "shadowRadius": 20, "shadowOffsetY": 8 }
    }
  },
  "scale": {
    "type": {
      "note": "Mobile-first. control (15/20) and control-lg (17/24) are the control-label steps (labels, tabs, radio rows, toast text, large button). Body is never below 16px. Secondary text and captions never below 14px. Badges and nav labels 13px minimum. Desktop values apply from lg (1024px).",
