# Local values for the API: copy to apps/api/.env.local (gitignored). lib/config.ts and prisma.config.ts read it;
# real environment variables win. Every variable name is listed in the root .env.example.
APP_ENV=local
APP_VERSION=dev
PORT=4000
WEB_ORIGINS=http://localhost:3000
# ?schema=app is required (ADR-021). Moved Supabase ports (supabase/README.md)? Change 54322 here too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=app
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=app
# Local Supabase demo values (`pnpm exec supabase status`: API_URL, JWT_SECRET; moved ports? change 54321 too).
# The JWT secret signs test tokens and the local Admin API token that creates the fixture users (seeder 00-users).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Server-only sb_secret_ key (`supabase status`: Secret). Used for the Auth Admin API. Old name SUPABASE_SERVICE_ROLE_KEY still read for one release.
SUPABASE_SECRET_KEY=
# Local-only secrets (C1): HMAC salt for IP and device ids, key for encrypted idempotency responses, public blur key (C6).
RATE_SALT=local-only-rate-salt-0123456789abcdef0123456789
IDEMPOTENCY_KEY=local-only-idempotency-key-0123456789abcdef01
FUZZ_SECRET=local-only-fuzz-secret-0123456789abcdef0123456
