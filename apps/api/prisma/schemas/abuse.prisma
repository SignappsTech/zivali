// Abuse reports and moderation flags (C11). Targets are polymorphic (target_type + target_id), so no foreign keys.
// A report carries ids, the reason and an optional note only. Written by TASK-25.2; RLS deny-all (ADR-021).

enum ABUSE_REASON {
  SCAM
  FAKE
  SPAM
  INAPPROPRIATE_IMAGE
  OTHER

  @@schema("app")
}

model abuse_reports {
  id          String       @id @default(uuid()) @db.Uuid
  reporter_id String       @db.Uuid
  // 'report' | 'message' | 'profile' (check in the migration)
  target_type String
  target_id   String       @db.Uuid
  reason      ABUSE_REASON
  note        String?      @db.VarChar(500)
  // 1.0, or 0.5 when the reporter account is younger than 24 h
  weight      Decimal      @default(1.0) @db.Decimal(2, 1)
  // 'open' | 'dismissed' | 'actioned' (check in the migration)
  status      String       @default("open")
  created_at  DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([reporter_id, target_type, target_id])
  @@index([target_type, target_id])
  @@schema("app")
}

model moderation_flags {
  id          String    @id @default(uuid()) @db.Uuid
  // 'duplicate_chip' | 'anon_hold' | 'auto_hidden' (check in the migration)
  kind        String
  target_type String
  target_id   String    @db.Uuid
  details     Json?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at DateTime? @db.Timestamptz(6)

  @@index([target_type, target_id])
  @@schema("app")
}
