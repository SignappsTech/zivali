// Profiles and roles (C3). profiles.id equals the Supabase auth.users.id; there is no foreign key into `auth`.

enum USER_ROLE {
  USER
  SHELTER_MEMBER
  MODERATOR
  ADMIN

  @@schema("app")
}

model profiles {
  id                      String                                           @id @db.Uuid
  display_name            String?                                          @db.VarChar(60)
  locale                  String                                           @default("sl")
  role                    USER_ROLE                                        @default(USER)
  // Private; written only through TypedSQL / $queryRaw with the coarsened point (C6).
  home_point              Unsupported("extensions.geography(Point,4326)")?
  home_radius_km          Int                                              @default(5)
  // Private: never public, never in analytics.
  phone                   String?
  is_anonymous            Boolean                                          @default(false)
  supporter_badge_visible Boolean                                          @default(true)
  // "22:00", Europe/Ljubljana
  quiet_from              String?
  quiet_to                String?
  created_at              DateTime                                         @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                                         @updatedAt @db.Timestamptz(6)

  @@schema("app")
}
