// Photos of a report or a pet (C5). Objects live in R2 (MinIO locally); public URLs are set by photo.publish.

// pending: POST /v1/photos created the row, no upload confirmed yet; POST /v1/photos/:id/complete sets uploaded (C5).
enum PHOTO_STATUS {
  pending
  uploaded
  accepted
  rejected
  published
  unpublished

  @@schema("app")
}

enum PHOTO_REJECT_REASON {
  not_jpeg
  too_large
  hash_mismatch
  decode_failed

  @@schema("app")
}

model photos {
  id                 String               @id @default(uuid()) @db.Uuid
  owner_id           String               @db.Uuid
  owner              profiles             @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  // A pet's photo may also be on one report (a lost report of the pet, TASK-114.5). Unattached uploads are purged
  // after 24 h.
  pet_id             String?              @db.Uuid
  pet                pets?                @relation(fields: [pet_id], references: [id], onDelete: SetNull)
  report_id          String?              @db.Uuid
  report             reports?             @relation(fields: [report_id], references: [id], onDelete: SetNull)
  // 0–4
  position           Int                  @default(0) @db.SmallInt
  sha256             String
  width              Int
  height             Int
  bytes              Int
  status             PHOTO_STATUS         @default(pending)
  reject_reason      PHOTO_REJECT_REASON?
  public_display_url String?
  public_thumb_url   String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  // The 24 h purge clock of an unattached photo: retention.purge deletes it 24 h after the last write; POST /v1/photos
  // answering `existing: true` touches it (CH-134).
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([owner_id, sha256])
  // The anonymous hold rule looks up the same image across owners (C7).
  @@index([sha256])
  @@index([report_id])
  @@index([pet_id])
  @@schema("app")
}
