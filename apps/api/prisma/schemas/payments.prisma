// Payments ledger (C13, ADR-011): Stripe test mode or the mock provider. Only provider ids are stored, never card
// data. Rewards are display-only (C4) and never a payment. Written by TASK-32.1; RLS deny-all (ADR-021).

enum PAYMENT_PURPOSE {
  TIP
  REPORT_CONTRIBUTION
  SUPPORT
  BOOST
  SUBSCRIPTION

  @@schema("app")
}

enum PAYMENT_STATUS {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED

  @@schema("app")
}

model payments {
  id                  String          @id @default(uuid()) @db.Uuid
  // null once the account is deleted: the accounting record stays, anonymised
  user_id             String?         @db.Uuid
  purpose             PAYMENT_PURPOSE
  // integer cents, >= 200 (check in the migration)
  amount_cents        Int
  // 'EUR' only (check in the migration)
  currency            String          @default("EUR")
  status              PAYMENT_STATUS  @default(PENDING)
  // 'stripe' | 'mock' (check in the migration)
  provider            String
  provider_session_id String?         @unique
  provider_payment_id String?
  // e.g. { "report_id": "…" }
  refs                Json?
  receipt_sent_at     DateTime?       @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @updatedAt @db.Timestamptz(6)
  user                profiles?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  invoice             invoices?

  @@index([user_id, created_at])
  @@schema("app")
}

enum INVOICE_STATUS {
  PENDING
  VERIFIED
  FAILED

  @@schema("app")
}

// Fiscal invoice of a succeeded payment (C13 §Fiscal invoices, TASK-92): one per payment, created by payment.effects,
// verified through the fiscal adapter (ZOI ours, EOR from FURS). Accounting record: kept 10 years (ZDDV-1), never
// deleted with the account (the payment is anonymised instead).
model invoices {
  id          String         @id @default(uuid()) @db.Uuid
  payment_id  String         @unique @db.Uuid
  // FURS BusinessPremiseID and ElectronicDeviceID at issue, and the gapless sequence of that series
  premise_id  String
  device_id   String
  sequence    Int
  // <premise_id>-<device_id>-<sequence>, as printed
  number      String         @unique
  // Fixed at creation (ZOI input): a retry sends the same data
  issued_at   DateTime       @db.Timestamptz(6)
  // integer cents; net + vat = gross = payments.amount_cents (check in the migration)
  net_cents   Int
  // percent
  vat_rate    Int
  vat_cents   Int
  gross_cents Int
  // 'mock' | 'furs' (check in the migration)
  provider    String
  zoi         String
  eor         String?
  status      INVOICE_STATUS @default(PENDING)
  // fiscal verification attempts; FAILED after the last one
  attempts    Int            @default(0)
  verified_at DateTime?      @db.Timestamptz(6)
  // object key in the private bucket, set once the worker has rendered the PDF
  pdf_key     String?
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @updatedAt @db.Timestamptz(6)
  payment     payments       @relation(fields: [payment_id], references: [id], onDelete: Restrict)

  @@unique([premise_id, device_id, sequence])
  @@schema("app")
}

// Last issued sequence per FURS premise and device. The upsert's row lock serialises issuers until their invoice
// commits, and a rolled-back invoice returns its number, so a series has no gaps.
model invoice_sequences {
  premise_id    String
  device_id     String
  last_sequence Int

  @@id([premise_id, device_id])
  @@schema("app")
}

// Webhook ledger: a duplicate provider_event_id is a no-op.
model payment_events {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  provider_event_id String   @unique
  type              String
  // A redacted summary (C13), NEVER the raw provider event (it carries customer details and card brand/last4/expiry):
  // only the keys id, type, object_id, payment_intent, amount, currency, status, livemode (check in the migration).
  payload           Json
  received_at       DateTime @default(now()) @db.Timestamptz(6)

  @@schema("app")
}
