			"basis": "consent (GDPR art. 6(1)(a)): opt-in nearby alerts (FR-010)",
			"retention": "until the user deletes it or the account",
			"export": true,
			"delete": "delete",
			"other_columns": ["id", "created_at", "updated_at"]
		},
		"alert_deliveries": {
