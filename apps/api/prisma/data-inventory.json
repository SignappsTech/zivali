			"export": true,
			"delete": "delete",
			"other_columns": ["id", "type", "dedupe_key", "created_at"]
		},
		"notification_prefs": {
			"category": "notifications",
			"personal_data": ["user_id", "in_app", "push", "email"],
			"basis": "contract (GDPR art. 6(1)(b))",
