			"delete": "delete",
			"other_columns": ["match_id", "verdict", "created_at"]
		},
		"conversations": {
			"category": "chat",
			"personal_data": [],
			"basis": "contract (GDPR art. 6(1)(b)): owner-finder chat (FR-009)",
