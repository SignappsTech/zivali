{
	"$comment": "Every Prisma model (exact column names, split into personal_data and other_columns) and R2 bucket (C1). test/security/data-inventory.test.ts fails when a model or an app column is missing. export: part of the user's data export; delete: what account deletion does. Notes: rate_limits.key is the user id or an HMAC of the IP or device id; idempotency_keys.body is the stored response.",
	"models": {
		"profiles": {
			"category": "account",
			"personal_data": [
				"id",
				"display_name",
				"locale",
				"home_point",
				"home_radius_km",
				"phone",
				"quiet_from",
				"quiet_to"
			],
			"basis": "contract (GDPR art. 6(1)(b))",
			"retention": "until the account is deleted",
			"export": true,
			"delete": "delete",
			"other_columns": ["role", "is_anonymous", "supporter_badge_visible", "created_at", "updated_at"]
		},
		"app_config": {
			"category": "platform",
			"personal_data": [],
			"basis": "none (no personal data)",
			"retention": "kept",
			"export": false,
			"delete": "keep",
			"other_columns": ["key", "value", "is_public", "description", "updated_at"]
		},
		"audit_log": {
			"category": "security",
			"personal_data": ["actor_id", "target_id", "diff"],
