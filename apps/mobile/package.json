{
	"name": "mobile",
	"version": "0.1.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"build": "expo export --platform android",
		"lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings=0 .",
		"typecheck": "tsc",
		"test": "jest",
		"postinstall": "pnpm --filter @zivali/tokens --filter @zivali/i18n build"
	},
	"dependencies": {
		"@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
		"@expo-google-fonts/bricolage-grotesque": "^0.4.1",
		"@formatjs/intl-pluralrules": "^6.3.15",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-firebase/analytics": "26.4.0",
		"@react-native-firebase/app": "26.4.0",
		"@react-native-google-signin/google-signin": "^16.1.5",
		"@reduxjs/toolkit": "^2.13.0",
		"@rn-primitives/alert-dialog": "^1.5.2",
		"@rn-primitives/avatar": "^1.5.2",
		"@rn-primitives/checkbox": "^1.5.2",
		"@rn-primitives/dialog": "^1.5.2",
		"@rn-primitives/hooks": "^1.5.2",
		"@rn-primitives/portal": "^1.5.3",
		"@rn-primitives/radio-group": "^1.5.2",
		"@rn-primitives/slot": "^1.5.2",
		"@rn-primitives/switch": "^1.5.2",
		"@rn-primitives/tabs": "^1.5.2",
		"@supabase/supabase-js": "^2.117.3",
		"@zivali/analytics": "workspace:*",
		"@zivali/api": "workspace:*",
		"@zivali/i18n": "workspace:*",
		"@zivali/tokens": "workspace:*",
		"@zivali/validation": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"expo": "~57.0.29",
		"expo-apple-authentication": "~57.0.2",
		"expo-background-task": "~57.0.21",
		"expo-build-properties": "~57.0.22",
		"expo-constants": "~57.0.22",
		"expo-crypto": "~57.0.4",
		"expo-dev-client": "~57.0.20",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.4",
		"expo-image-manipulator": "~57.0.21",
		"expo-image-picker": "~57.0.20",
		"expo-linking": "~57.0.13",
		"expo-location": "~57.0.21",
		"expo-network": "~57.0.2",
		"expo-notifications": "~57.0.22",
		"expo-router": "~57.0.27",
		"expo-secure-store": "~57.0.4",
		"expo-splash-screen": "~57.0.10",
		"expo-sqlite": "~57.0.4",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"expo-task-manager": "~57.0.21",
		"expo-web-browser": "~57.0.3",
		"nativewind": "^4.2.7",
		"phosphor-react-native": "3.0.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-webview": "13.16.1",
		"react-native-worklets": "0.10.1",
		"react-redux": "^9.3.0",
		"sonner-native": "^0.27.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"use-intl": "^4.14.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.1.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.20.5",
		"@types/react": "~19.2.2",
		"eslint-config-expo": "~57.0.2",
		"jest": "^29.7.0",
		"jest-expo": "~57.0.6",
		"tailwindcss": "^3.4.19",
		"test-renderer": "~1.2.0",
		"typescript": "~6.0.3"
	},
	"jest": {
		"preset": "jest-expo",
		"maxWorkers": "25%",
		"setupFiles": [
			"./jest.setup.ts"
		],
		"transformIgnorePatterns": [
			"/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|use-intl|icu-minify|intl-messageformat|@formatjs|immer|@rn-primitives|phosphor-react-native|sonner-native|@gorhom|react-redux|@reduxjs|redux|redux-thunk|reselect))",
			"/node_modules/react-native-reanimated/plugin/",
			"/node_modules/@react-native/babel-preset/"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/$1",
			"^@zivali/analytics$": "<rootDir>/../../packages/analytics/src/index.ts",
			"^@zivali/api/(.*)$": "<rootDir>/../../packages/api/src/$1.ts",
			"^@zivali/i18n/format$": "<rootDir>/../../packages/i18n/src/format.ts",
			"^@zivali/types$": "<rootDir>/../../packages/types/src/index.ts",
			"^@zivali/types/domain/(.*)$": "<rootDir>/../../packages/types/src/domain/$1.ts",
			"^@zivali/validation$": "<rootDir>/../../packages/validation/src/index.ts",
			"^@zivali/validation/(.*)$": "<rootDir>/../../packages/validation/src/$1.ts"
		}
	}
}
