{
	"name": "mobile",
	"version": "0.1.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"build": "expo export --platform android",
		"lint": "eslint --max-warnings=0 .",
		"typecheck": "tsc",
		"test": "jest",
		"postinstall": "pnpm --filter @zivali/tokens build"
	},
	"dependencies": {
		"@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
		"@expo-google-fonts/bricolage-grotesque": "^0.4.1",
		"@rn-primitives/portal": "^1.5.3",
		"@supabase/supabase-js": "^2.117.3",
		"@zivali/tokens": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"expo": "~57.0.29",
		"expo-constants": "~57.0.22",
		"expo-dev-client": "~57.0.20",
		"expo-font": "~57.0.4",
		"expo-linking": "~57.0.13",
		"expo-router": "~57.0.27",
		"expo-splash-screen": "~57.0.10",
		"expo-sqlite": "~57.0.4",
		"expo-status-bar": "~57.0.1",
		"expo-system-ui": "~57.0.4",
		"nativewind": "^4.2.7",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-worklets": "0.10.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"use-intl": "^4.14.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.1.0",
		"@types/jest": "^29.5.14",
		"@types/react": "~19.2.2",
		"eslint-config-expo": "~57.0.2",
		"jest": "^29.7.0",
		"jest-expo": "~57.0.6",
		"tailwindcss": "^3.4.19",
		"test-renderer": "~1.2.0",
		"typescript": "~6.0.3"
	},
	"jest": {
		"preset": "jest-expo",
		"transformIgnorePatterns": [
			"/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|use-intl|icu-minify|intl-messageformat|@formatjs))",
			"/node_modules/react-native-reanimated/plugin/",
			"/node_modules/@react-native/babel-preset/"
		],
		"moduleNameMapper": {
			"^@/(.*)$": "<rootDir>/$1"
		}
	}
}
